    {
      "name": "Time Tracking",
      "item": [
        {
          "name": "Start Time Tracking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"{{task_id}}\",\n  \"description\": \"Starting work on task\",\n  \"ip_address\": \"192.168.1.1\",\n  \"mac_address\": \"00:11:22:33:44:55\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/time-tracking/start",
              "host": ["{{base_url}}"],
              "path": ["api", "time-tracking", "start"]
            }
          },
          "response": []
        },
        {
          "name": "Pause Time Tracking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"{{task_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/time-tracking/pause",
              "host": ["{{base_url}}"],
              "path": ["api", "time-tracking", "pause"]
            }
          },
          "response": []
        },
        {
          "name": "Resume Time Tracking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"{{task_id}}\",\n  \"ip_address\": \"192.168.1.1\",\n  \"mac_address\": \"00:11:22:33:44:55\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/time-tracking/resume",
              "host": ["{{base_url}}"],
              "path": ["api", "time-tracking", "resume"]
            }
          },
          "response": []
        },
        {
          "name": "Complete Time Tracking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"{{task_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/time-tracking/complete",
              "host": ["{{base_url}}"],
              "path": ["api", "time-tracking", "complete"]
            }
