                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{task_id}}\",\n  \"employee_id\": \"{{employee_id}}\",\n  \"status\": \"In Progress\",\n  \"task_name\": \"Updated Task Name\",\n  \"task_description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tasks",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"]
            }
          },
          "response": []
        }
